# Copy this file to keystore.properties (same folder) and fill in your
# real values. keystore.properties is gitignored and must never be
# committed — it holds the passwords for your app's signing key.
#
# storeFile can be an absolute path, or a path relative to the project
# root, e.g. ../kaloutas-release-key.jks to keep it outside the repo folder.

storeFile=CHANGE_ME.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
